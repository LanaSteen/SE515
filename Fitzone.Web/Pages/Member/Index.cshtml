@page
@model Fitzone.Web.Pages.Member.IndexModel
@{
    ViewData["Title"] = "Members";
}

@section Styles {
    <link rel="stylesheet" href="~/css/member.css" />
}

    
<h2 class="main-title">Members</h2>


<a asp-page="Create" class="btn accept-policy">Add Member</a>

<ul>
    @foreach (var member in Model.Members)
    {
        <li>@member.FirstName @member.LastName - @member.TrainerId
            
          <a asp-page="Details" asp-route-id="@member.Id" class="btn btn-primary">Details</a>

            <a asp-page="Edit" asp-route-id="@member.Id" class="btn btn-warning">Edit</a>
            <a asp-page="Delete" asp-route-id="@member.Id" class="btn btn-danger">Delete</a>
        </li>
       
       
    }
</ul>

