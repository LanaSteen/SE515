@page "{id:int}"
@using FitZone.Domain.Models.Enums
@model Fitzone.Web.Pages.Member.EditModel
@{
  ViewData["Title"] = "Edit Member";
}


<h2>@ViewData["Title"]</h2>

<form method="post">
   

    <input type="hidden" asp-for="Member.Id" />

    <div class="form-group">
        <label asp-for="Member.FirstName"></label>
        <input asp-for="Member.FirstName" class="form-control" />
        <span asp-validation-for="Member.FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Member.LastName"></label>
        <input asp-for="Member.LastName" class="form-control" />
        <span asp-validation-for="Member.LastName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Member.TrainerId"></label>
        <input asp-for="Member.TrainerId" class="form-control" />
    </div>

    <div>
        <label asp-for="Member.MembershipType"> Membership Type</label> 
        <select asp-for="Member.MembershipType" class="form-control"
                      asp-items="Html.GetEnumSelectList<MembershipType>()" class="form-select">
           
       </select>



    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn accept-policy">Go Back</a>


</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
